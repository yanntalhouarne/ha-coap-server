if BOARD_HACOAP

config BOARD_ENABLE_DCDC
	bool "DCDC mode"
	select SOC_DCDC_NRF52X
	default y
	help
	  Run the nRF52840's main regulator (REG1) in DC/DC mode instead of LDO
	  mode, which roughly halves the current drawn by the radio and CPU.
	  The ACN52840 module includes the inductor the DC/DC converter needs.
	  If a board does not boot with it enabled, turn it off for both images
	  (MCUboot does not inherit the application's setting):
	  -DCONFIG_BOARD_ENABLE_DCDC=n -Dmcuboot_CONFIG_BOARD_ENABLE_DCDC=n

endif # BOARD_HACOAP
